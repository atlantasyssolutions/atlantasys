/**
 * FAQ Accordion
 *
 * Accessible accordion using aria-expanded / aria-controls / [hidden].
 * Supports keyboard navigation (Enter, Space, Arrow keys, Home, End).
 *
 * Enqueue in functions.php:
 *   wp_enqueue_script('faq-accordion', get_template_directory_uri() . '/js/faq-accordion.js', [], null, true);
 */

document.addEventListener('DOMContentLoaded', function () {

  document.querySelectorAll('.faq-accordion').forEach(function (accordion) {

    var headers = Array.from(accordion.querySelectorAll('.faq-accordion__header'));

    // -------------------------------------------------------------------------
    // Open / close a single item
    // -------------------------------------------------------------------------

    function openItem(header) {
      var panel = document.getElementById(header.getAttribute('aria-controls'));
      if (!panel) return;

      header.setAttribute('aria-expanded', 'true');
      panel.removeAttribute('hidden');
      panel.style.visibility = '';

      // Animate: set max-height to scrollHeight so CSS transition plays
      panel.style.maxHeight = panel.scrollHeight + 'px';
    }

    function closeItem(header) {
      var panel = document.getElementById(header.getAttribute('aria-controls'));
      if (!panel) return;

      header.setAttribute('aria-expanded', 'false');
      panel.style.maxHeight = '0';

      // After transition ends restore [hidden] for accessibility
      panel.addEventListener('transitionend', function () {
        if (header.getAttribute('aria-expanded') === 'false') {
          panel.setAttribute('hidden', '');
          panel.style.visibility = 'hidden';
        }
      }, { once: true });
    }

    function toggleItem(header) {
      var isOpen = header.getAttribute('aria-expanded') === 'true';
      // Close all other items (single-open behaviour)
      headers.forEach(function (h) {
        if (h !== header && h.getAttribute('aria-expanded') === 'true') {
          closeItem(h);
        }
      });
      isOpen ? closeItem(header) : openItem(header);
    }

    // -------------------------------------------------------------------------
    // Click handler
    // -------------------------------------------------------------------------

    headers.forEach(function (header) {
      header.addEventListener('click', function () {
        return toggleItem(header);
      });
    });

    // -------------------------------------------------------------------------
    // Keyboard navigation (ARIA Authoring Practices Guide – Accordion pattern)
    // -------------------------------------------------------------------------

    headers.forEach(function (header, index) {
      header.addEventListener('keydown', function (e) {
        var targetIndex = null;

        switch (e.key) {
          case 'ArrowDown':
            targetIndex = (index + 1) % headers.length;
            break;
          case 'ArrowUp':
            targetIndex = (index - 1 + headers.length) % headers.length;
            break;
          case 'Home':
            targetIndex = 0;
            break;
          case 'End':
            targetIndex = headers.length - 1;
            break;
          default:
            return;
        }

        e.preventDefault();
        headers[targetIndex].focus();
      });
    });
  });
});

document.addEventListener("DOMContentLoaded", function () {
  var toggle = document.querySelector("#hamburger__icon"),
      close = document.querySelector("#close"),
      sidebar = document.querySelector("#mobile-menu");

  toggle.addEventListener("click", function (e) {
    e.preventDefault();
    e.stopPropagation();
    sidebar.classList.add("show-nav");
  });

  close.addEventListener("click", function (e) {
    e.preventDefault();
    e.stopPropagation();
    sidebar.classList.remove("show-nav");
  });

  var dropdown = document.getElementsByClassName("mobile-menu__list--item");
  var i;

  for (i = 0; i < dropdown.length; i++) {
    dropdown[i].addEventListener("click", function (e) {
      e.stopPropagation();
      this.classList.toggle("active");
    });
  }
});

document.addEventListener("DOMContentLoaded", function () {
  var imageCameras = document.querySelectorAll(".trucks-cams__trucks--image .icon");
  var truckBox = document.querySelectorAll(".trucks-cams__cams__box");

  imageCameras.forEach(function (item, index) {
    item.addEventListener("mouseover", function (item) {
      var elmId = item.target.getAttribute("data-href");
      document.getElementById(elmId).classList.add("hover");
    });
    item.addEventListener("mouseout", function (item) {
      var elmId = item.target.getAttribute("data-href");
      document.getElementById(elmId).classList.remove("hover");
    });
  });

  truckBox.forEach(function (item, index) {
    item.addEventListener("mouseover", function (item) {
      var elmId = item.target.getAttribute("data-target");
      document.getElementById(elmId).classList.add("hover");
    });
    item.addEventListener("mouseout", function (item) {
      var elmId = item.target.getAttribute("data-target");
      document.getElementById(elmId).classList.remove("hover");
    });
  });

  truckBox.forEach(function (item, index) {
    item.addEventListener("mouseover", function (item) {
      var elmId = item.target.getAttribute("data-href");
      document.getElementById(elmId).classList.add("hover");
    });
    item.addEventListener("mouseout", function (item) {
      var elmId = item.target.getAttribute("data-href");
      document.getElementById(elmId).classList.remove("hover");
    });
  });
});

document.addEventListener("DOMContentLoaded", function () {
  if (document.getElementById("hamburger__tmobile")) {
    var myToggle = function myToggle() {
      this.classList.toggle("visible-menu");
    };

    var hamburger = document.getElementById("hamburger__tmobile");
    var navUL = document.querySelector(".navigation__tmobile__list");
    var submenu = document.querySelector(".navigation__tmobile__list").getElementsByTagName("li");
    var numSubmenu = submenu.length;
    var menuOpen = false;

    for (var i = 0; i < numSubmenu; i++) {
      submenu[i].addEventListener("click", myToggle, false);
    }

    hamburger.addEventListener("click", function () {
      navUL.classList.toggle("show-nav");

      if (!menuOpen) {
        hamburger.classList.add("open");
        menuOpen = true;
      } else {
        hamburger.classList.remove("open");
        menuOpen = false;
      }
    });
  }
});

document.addEventListener("DOMContentLoaded", function () {
  var acc = document.getElementsByClassName("accordion");
  var i;

  for (i = 0; i < acc.length; i++) {
    acc[i].addEventListener("click", function () {
      this.classList.toggle("active");
      var panel = this.nextElementSibling;

      if (panel.style.maxHeight) {
        panel.style.maxHeight = null;
      } else {
        panel.style.maxHeight = panel.scrollHeight + "px";
      }
    });
  }
});

/* Show submenus after load website */

document.addEventListener("DOMContentLoaded", function () {
  document.querySelector(".sub-menu--resources--outer").classList.add("loaded");
  document.querySelector(".sub-menu--solutions--outer").classList.add("loaded");
  document.querySelector(".sub-menu--outer").classList.add("loaded");
});

document.addEventListener("DOMContentLoaded", function () {
  if (document.querySelector("#fts-knowladge") && window.innerWidth <= 768) {
    setTimeout(function () {
      document.querySelector("#fts-knowladge").scrollIntoView();
    }, 300);
  }
});

document.addEventListener("DOMContentLoaded", function () {
  var itemsMenu = document.querySelectorAll("ul.nav-menu__list > li.nav-menu__list__li__parent"),
      hoverTimeout = void 0;

  itemsMenu.forEach(function (item) {
    item.addEventListener("mouseover", function (ev) {
      clearTimeout(hoverTimeout);
      document.body.classList.add("hover-menu");
    });
    item.addEventListener("mouseout", function (ev) {
      hoverTimeout = setTimeout(function () {
        document.body.classList.remove("hover-menu");
      }, 0);
    });
  });
});

//Glossary btn

document.addEventListener("DOMContentLoaded", function () {
  var glossaryBtn = document.querySelector(".glossary__entry--btn");

  if (glossaryBtn) {
    glossaryBtn.addEventListener("click", function (e) {
      window.scrollTo({
        top: 0,
        left: 0,
        behavior: "smooth"
      });
    });

    window.addEventListener("scroll", function (e) {
      glossaryBtn.style.display = window.scrollY > 500 ? "inline-block" : "none";
    });
  }
});

//Stories btn

document.addEventListener("DOMContentLoaded", function () {
  var storiesBtn = document.querySelector(".stories--btn");

  if (storiesBtn) {
    storiesBtn.addEventListener("click", function (e) {
      window.scrollTo({
        top: 0,
        left: 0,
        behavior: "smooth"
      });
    });

    window.addEventListener("scroll", function (e) {
      var scrollTop = window.scrollY;
      var docHeight = document.body.offsetHeight;
      var winHeight = window.innerHeight;
      var scrollPercent = scrollTop / (docHeight - winHeight);
      var scrollPercentRounded = Math.round(scrollPercent * 100);
      storiesBtn.style.display = scrollPercentRounded > 50 ? "inline-block" : "none";
    });
  }
});

//Share copy

document.addEventListener("DOMContentLoaded", function () {
  var copyLinks = document.querySelectorAll(".share__widget--link");

  copyLinks.forEach(function (copyLink) {
    copyLink.addEventListener("click", function () {
      copyLinks.forEach(function (copy) {
        return copy.classList.remove("copied");
      });
      copyLink.classList.add("copied");
    });
  });
});

//Footer Mobile

document.addEventListener("DOMContentLoaded", function () {
  var footer_drop = document.querySelectorAll(".footer__box__inner__main--header");

  footer_drop.forEach(function (drop) {
    drop.addEventListener("click", function (e) {
      e.target.parentNode.classList.toggle("open");
    });
  });
});

// wow elements

document.addEventListener("DOMContentLoaded", function () {
  new WOW().init();
});

$(document).ready(function () {
  $(".owl-main").owlCarousel({
    items: 1,
    loop: true
  });

  $(".owl-quotes").owlCarousel({
    items: 1,
    loop: true,
    nav: true,
    dotsContainer: '#owl-quotes-dots'
  });

  $(".owl-compare").owlCarousel({
    items: 6,
    nav: true,
    responsive: {
      0: {
        items: 1,
        autoplay: true
      },
      480: {
        items: 2,
        autoplay: true
      },
      768: {
        items: 4
      },
      989: {
        items: 5
      },
      1200: {
        items: 6
      }
    }
  });

  $(".owl-industries1").owlCarousel({
    items: 4,
    loop: true,
    autoplay: true,
    nav: false,
    dots: false,
    autoplayTimeout: 4000,
    smartSpeed: 8000,
    responsive: {
      0: {
        items: 1,
        autoplay: true
      },
      480: {
        items: 2,
        autoplay: true
      },
      768: {
        items: 4
      }
    }
  });

  $(".owl-industries2").owlCarousel({
    items: 4,
    loop: true,
    autoplay: true,
    autoplayTimeout: 4000,
    smartSpeed: 8000,
    rtl: true,
    responsive: {
      0: {
        items: 1,
        autoplay: true
      },
      480: {
        items: 2,
        autoplay: true
      },
      768: {
        items: 4
      }
    }
  });

  $(".owl-waste").owlCarousel({
    items: 5,
    autoplayTimeout: 4000,
    loop: true,
    autoplay: true
  });

  $(".owl-ruged").owlCarousel({
    items: 1,
    autoplay: true
  });

  $(".owl-garmin").owlCarousel({
    items: 1,
    autoplay: true
  });

  $(".owl-pets").owlCarousel({
    items: 1,
    autoplay: true,
    nav: true
  });

  $(".owl-itegration").owlCarousel({
    items: 4,
    margin: 10,
    responsive: {
      0: {
        items: 1,
        autoplay: true
      },
      480: {
        items: 2,
        autoplay: true
      },
      768: {
        items: 4
      }
    }
  });

  $(".owl-case").owlCarousel({
    items: 3,
    autoplay: true,
    margin: 100,
    loop: true,
    responsive: {
      0: {
        items: 2
      },
      480: {
        items: 2
      },
      768: {
        items: 3
      }
    }
  });

  $(".owl-logos").owlCarousel({
    items: 5,
    autoplay: true,
    autoplayTimeout: 3000,
    smartSpeed: 3000,
    margin: 100,
    loop: true,
    dots: false,
    responsive: {
      0: {
        items: 2
      },
      480: {
        items: 3
      },
      768: {
        items: 4
      }
    }
  });

  // RC Related Articles Carousel
  var $rcGrid = $('.rc-related__grid');
  if ($rcGrid.length && $rcGrid.find('.rc-related__card').length > 3) {
    $rcGrid.addClass('owl-carousel');
    $rcGrid.owlCarousel({
      items: 4,
      loop: true,
      nav: true,
      dots: true,
      margin: 24,
      responsive: {
        0: {
          items: 1
        },
        600: {
          items: 2
        },
        900: {
          items: 3
        },
        1200: {
          items: 4
        }
      }
    });
  }

  // Testimonial Owl Carousel
  $('.testimonial-carousel').owlCarousel({
    loop: true,
    margin: 32,
    nav: false,
    dots: true,
    autoplay: true,
    autoHeight: false,
    autoplayTimeout: 5000,
    autoplayHoverPause: true,
    responsive: {
      0: {
        items: 1
      },
      768: {
        items: 2
      }
    }
  });
});

document.addEventListener('DOMContentLoaded', function () {

  // Tab switching
  $('.tabs-element .tab').on('click', function () {
    var tabId = $(this).data('tab');

    $('.tabs-element .tab').removeClass('tab--active');
    $(this).addClass('tab--active');

    $('.featured-tab-panels .featured-tab').hide();
    $('#' + tabId).fadeIn(300);
  });
});

