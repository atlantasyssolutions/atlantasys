var btns = document.querySelectorAll('[data-tab]');
var tabs = document.querySelectorAll('[data-tab-content]');

tabs.forEach(function (tab) {
  tab.style.display = "none";
  if (tab.dataset.active === 'true') {
    tab.classList.add('active');
    tab.style.display = "block";
    tab.style.maxHeight = "auto";
    void 0;
  }
});
btns.forEach(function (btn) {
  if (btn.dataset.active === 'true') {
    btn.classList.add('active');
    btn.style.display = "block";
  }
  btn.addEventListener('click', function (e) {
    if (!e.target.closest('[data-tab]')) {
      return null;
    }
    var btnEl = e.target.closest('[data-tab]');
    void 0;
    if (typeof btnEl.parentElement.parentElement.id === 'undefined') {
      //console.error('Tab parent element dose not have valid id')
      return null;
    }
    //console.log({woot: document.querySelector(`#${btnEl.parentElement.parentElement.id} > .tab__header >.tab__nav.active`)})
    document.querySelector('#' + btnEl.parentElement.parentElement.id + ' > .tab__header >.tab__nav.active').classList.remove(['active']);
    btnEl.classList.add('active');
    tabs.forEach(function (tab) {
      if (tab.parentElement.parentElement.id === btn.parentElement.parentElement.id) {
        if (tab.dataset.tabContent === btn.dataset.tab) {
          setTimeout(function () {

            tab.style.display = "block";
            tab.style.maxHeight = "auto";
            tab.classList.add('active');
          }, 300);
        } else {
          setTimeout(function () {
            tab.style.display = "none";
          }, 300);
          tab.classList.remove('active');
        }
      }
    });
  });
});

