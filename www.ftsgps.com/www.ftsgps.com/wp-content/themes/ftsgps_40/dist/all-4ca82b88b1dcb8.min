document.addEventListener("DOMContentLoaded", function () {
  //Asset Tracking

  document.querySelectorAll(".glide--comparison").forEach(function (element) {
    var configComparison = new Glide(element, {
      type: "slider",
      perView: 6,
      rewind: false,
      gap: 0,
      bound: true,
      breakpoints: {
        0: {
          perView: 1
        },
        480: {
          perView: 2
        },
        768: {
          perView: 3
        },
        989: {
          perView: 4
        },
        1300: {
          perView: 5
        },
        1600: {
          perView: 6
        }
      }
    });
    configComparison.mount();
  });

  document.querySelectorAll(".glide--assets-1").forEach(function (element) {
    var configAssets = new Glide(element, {
      type: "carousel",
      perView: 4,
      gap: 0,
      breakpoints: {
        610: {
          perView: 1
        },
        800: {
          perView: 2
        },
        1180: {
          perView: 3
        },
        1600: {
          perView: 4
        }
      },
      direction: "ltr",
      animationDuration: 9000,
      animationTimingFunc: "linear",
      autoplay: 9000,
      hoverpause: false,
      dragThreshold: 10
    });
    configAssets.mount();
  });

  document.querySelectorAll(".glide--assets-2").forEach(function (element) {
    var configAssets2 = new Glide(element, {
      type: "carousel",
      perView: 4,
      gap: 0,
      breakpoints: {
        610: {
          perView: 1
        },
        800: {
          perView: 2
        },
        1180: {
          perView: 3
        },
        1600: {
          perView: 4
        }
      },
      direction: "rtl",
      animationDuration: 9000,
      animationTimingFunc: "linear",
      autoplay: 9000,
      hoverpause: false,
      dragThreshold: 10
    });
    configAssets2.mount();
  });
});

