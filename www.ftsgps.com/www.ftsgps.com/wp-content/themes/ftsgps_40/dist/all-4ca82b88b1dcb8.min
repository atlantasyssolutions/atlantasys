    setOffset: setOffset,
    incrementPage: incrementPage,
    setPagesPerPage: setPagesPerPage,
    setElement: setElement,
    copyLink: copyLink
  };
};

document.addEventListener('DOMContentLoaded', function () {
  if (document.getElementById('newsroom-see-more')) {
    var _useNewsRoom = useNewsRoom(),
        setElement = _useNewsRoom.setElement,
        fetchPosts = _useNewsRoom.fetchPosts,
        setOffset = _useNewsRoom.setOffset;

    var nrElement = document.getElementById('newsroom-posts-list');
    setElement(nrElement);
    setOffset(Number(document.getElementById('newsroom-posts-list').dataset.postcount));
    document.getElementById('newsroom-see-more').addEventListener('click', function (e) {
      e.preventDefault();
      fetchPosts();
    });
  }

  var copyText = document.querySelectorAll(".fts-link");

  document.addEventListener("click", function (ev) {
    var target = ev.target.closest(".fts-link");

    if (target) {
      ev.preventDefault();
      var element = target;

      var storage = document.createElement('textarea');
      storage.value = element.getAttribute("href");
      element.appendChild(storage);

      storage.select();
      storage.setSelectionRange(0, 99999);
      document.execCommand('copy');
      element.removeChild(storage);

      target.querySelector('.fts-share-tooltip').textContent = 'link copied';
      setTimeout(function () {
        target.querySelector('.fts-share-tooltip').textContent = 'copy link';
      }, 1000);
    }
  });
});
